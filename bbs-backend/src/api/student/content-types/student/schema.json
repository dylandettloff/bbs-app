{
  "kind": "collectionType",
  "collectionName": "students",
  "info": {
    "singularName": "student",
    "pluralName": "students",
    "displayName": "Student"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "id_number": {
      "type": "integer",
      "required": true,
      "unique": true
    },
    "name": {
      "type": "string"
    },
    "party": {
      "type": "enumeration",
      "enum": [
        "Federalist",
        "Nationalist",
        "Independent"
      ]
    },
    "scheduleLevels": {
      "type": "json"
    },
    "city": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::city.city",
      "inversedBy": "students"
    },
    "user": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "plugin::users-permissions.user"
    }
  }
}
