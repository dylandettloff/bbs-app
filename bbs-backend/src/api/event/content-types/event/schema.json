{
  "kind": "collectionType",
  "collectionName": "events",
  "info": {
    "singularName": "event",
    "pluralName": "events",
    "displayName": "Event"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string"
    },
    "externalId": {
      "type": "string",
      "unique": true
    },
    "starts_at": {
      "type": "datetime"
    },
    "ends_at": {
      "type": "datetime"
    },
    "location": {
      "type": "string"
    },
    "description": {
      "type": "blocks"
    },
    "staffOnly": {
      "type": "boolean",
      "default": false
    },
    "allStudents": {
      "type": "boolean",
      "default": true
    },
    "partyAudience": {
      "type": "enumeration",
      "enum": [
        "All",
        "Federalist",
        "Nationalist",
        "Independent"
      ],
      "default": "All"
    },
    "targetCounties": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::county.county"
    },
    "targetCities": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::city.city"
    }
  }
}
