{
  "name": "bbs-backend",
  "version": "0.1.0",
  "private": true,
  "description": "A Strapi application",
  "scripts": {
    "prebuild": "rm -rf dist/build",
    "build": "node ./node_modules/@strapi/strapi/bin/strapi.js build",
    "console": "strapi console",
    "deploy": "strapi deploy",
    "dev": "node ./node_modules/@strapi/strapi/bin/strapi.js develop",
    "develop": "node ./node_modules/@strapi/strapi/bin/strapi.js develop",
    "prestart": "npm run build",
    "start": "NODE_ENV=production node ./node_modules/@strapi/strapi/bin/strapi.js start",
    "strapi": "node ./node_modules/@strapi/strapi/bin/strapi.js",
    "upgrade": "npx @strapi/upgrade latest",
    "upgrade:dry": "npx @strapi/upgrade latest --dry"
  },
  "dependencies": {
    "@strapi/plugin-cloud": "5.35.0",
    "@strapi/plugin-users-permissions": "5.35.0",
    "@strapi/strapi": "5.35.0",
    "better-sqlite3": "11.3.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-router-dom": "^6.0.0",
    "styled-components": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=18.0.0 <=22.x.x",
    "npm": ">=6.0.0"
  },
